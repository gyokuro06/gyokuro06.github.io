---
import { projects } from '../data/works';
import { getIcon } from '../lib/icons';
---

<section class="section" aria-labelledby="projects-heading">
	<div class="section-heading">
		<h2 id="projects-heading" class="section-title">参画プロジェクト</h2>
	</div>
	<div class="project-list">
		{projects.map((project) => (
			<article class="project-entry" aria-label={project.title}>
				<header class="project-header">
					<h3 class="project-title">{project.title}</h3>
					<div class="project-meta">
						<span class="project-period">{project.period}</span>
						<span class="project-meta-sep" aria-hidden="true" />
						<span class="project-meta-item">チーム {project.teamSize}</span>
						<span class="project-meta-sep" aria-hidden="true" />
						<span class="project-meta-item">{project.role}</span>
					</div>
					<ul class="project-tags">
						{project.techStack.map((tech) => {
							const icon = getIcon(tech);
							return (
								<li
									class="project-tag"
									style={icon ? `--brand: #${icon.hex}` : undefined}
									data-has-icon={icon ? '' : undefined}
								>
									{icon && (
										<svg
											class="skill-icon"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path d={icon.path} fill="currentColor" />
										</svg>
									)}
									{tech}
								</li>
							);
						})}
					</ul>
				</header>
				<div class="project-body">
					<div class="project-block">
						<h3 class="project-block-label">概要</h3>
						<p class="project-block-text">{project.summary}</p>
					</div>
					<div class="project-block">
						<h3 class="project-block-label">課題と解決</h3>
						<p class="project-block-text">{project.challenge}</p>
					</div>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.section-heading {
		padding-block-end: var(--space-3);
		border-block-end: 1px solid var(--c-line);
	}

	.section-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-xl);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--c-text);
	}

	.project-list {
		display: flex;
		flex-direction: column;
	}

	.project-entry {
		padding-block: var(--space-6);
		border-block-end: 1px solid var(--c-line);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.project-entry:first-child {
		padding-block-start: 0;
	}

	.project-entry:last-child {
		border-block-end: none;
		padding-block-end: 0;
	}

	.project-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.project-title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--c-text);
		line-height: 1.4;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35em 0;
		font-size: var(--text-sm);
		color: var(--c-text-sub);
	}

	.project-period {
		font-weight: 700;
		color: var(--c-text);
	}

	.project-meta-sep {
		display: inline-block;
		width: 1px;
		height: 0.85em;
		background: var(--c-line-strong);
		margin-inline: 0.65em;
		vertical-align: middle;
	}

	.project-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3em 0.45em;
	}

	.project-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		padding: 0.2em 0.5em;
		border: 1px solid var(--c-line-strong);
		border-radius: var(--radius-sm);
		background: var(--c-accent-soft);
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--c-text);
		line-height: 1.5;
	}

	.project-tag[data-has-icon] {
		border-color: color-mix(in srgb, var(--brand) 60%, transparent);
		background: color-mix(in srgb, var(--brand) 28%, var(--c-mix-paper));
		color: color-mix(in srgb, var(--brand) 78%, #000000);
		box-shadow: inset 0.22em 0 0 var(--brand);
	}

	.skill-icon {
		flex-shrink: 0;
		width: 1em;
		height: 1em;
		color: var(--brand, currentColor);
	}

	.project-tag:not([data-has-icon]) .skill-icon {
		opacity: 0.7;
	}

	.project-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.project-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.project-block-label {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--c-text-muted);
	}

	.project-block-text {
		margin: 0;
		font-size: var(--text-md);
		line-height: 1.85;
		color: var(--c-text);
		max-width: min(var(--measure-body), 100%);
	}

	@media print {
		.section {
			gap: var(--space-3);
		}

		.section-heading {
			padding-block-end: var(--space-1);
			border-color: var(--c-print-line);
			break-after: avoid;
		}

		.project-entry {
			padding-block: var(--space-3);
			gap: var(--space-2);
			border-color: var(--c-print-line);
			break-inside: auto;
			break-before: auto;
		}

		.project-header {
			gap: var(--space-1);
			break-inside: avoid;
			break-after: avoid;
		}

		.project-meta {
			color: var(--c-print-muted);
		}

		.project-period {
			color: var(--c-print-text);
		}

		.project-meta-sep {
			background: var(--c-print-line);
		}

		.project-tags {
			gap: 0.2em;
		}

		.project-tag,
		.project-tag[data-has-icon] {
			padding: 0.1em 0.4em;
			background: var(--c-print-tag-bg);
			border-color: var(--c-print-tag-border);
			color: var(--c-print-tag-text);
		}

		.skill-icon {
			color: currentColor;
		}

		.project-body {
			gap: var(--space-2);
		}

		.project-block-label {
			color: var(--c-print-muted);
			break-after: avoid;
		}

		.project-block-text {
			line-height: 1.55;
			max-width: none;
			orphans: 3;
			widows: 3;
		}
	}
</style>
