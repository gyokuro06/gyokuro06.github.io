---
import { projects } from '../data/works';
import { getIcon } from '../lib/icons';
---

<section class="section" aria-labelledby="projects-heading">
	<div class="section-heading">
		<h2 id="projects-heading" class="section-title">参画プロジェクト</h2>
	</div>
	<div class="project-list">
		{projects.map((project) => (
			<article class="project-card" aria-label={project.title}>
				<header class="project-header">
					<h3 class="project-title">{project.title}</h3>
					<div class="project-meta">
						<span class="project-period">{project.period}</span>
						<span class="project-meta-sep" aria-hidden="true">/</span>
						<span class="project-meta-item">チーム {project.teamSize}</span>
						<span class="project-meta-sep" aria-hidden="true">/</span>
						<span class="project-meta-item">{project.role}</span>
					</div>
					<ul class="project-tags">
						{project.techStack.map((tech, i) => {
							const icon = getIcon(tech);
							return (
								<>
									{i > 0 && (
										<li class="project-tag-sep" aria-hidden="true">·</li>
									)}
									<li class="project-tag">
										{icon && (
											<svg
												class="skill-icon"
												viewBox="0 0 24 24"
												aria-hidden="true"
											>
												<path d={icon.path} fill="currentColor" />
											</svg>
										)}
										{tech}
									</li>
								</>
							);
						})}
					</ul>
				</header>
				<div class="project-body">
					<div class="project-block">
						<h3 class="project-block-label">概要</h3>
						<p class="project-block-text">{project.summary}</p>
					</div>
					<div class="project-block">
						<h3 class="project-block-label">課題と解決</h3>
						<p class="project-block-text">{project.challenge}</p>
					</div>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.section-heading {
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--c-text);
	}

	.section-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-h2);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--c-text);
		line-height: 1.3;
	}

	.project-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.project-card {
		background: transparent;
		border: none;
		border-block-end: 1px solid var(--c-line);
		border-radius: 0;
		padding: var(--space-6) 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.project-card:first-child {
		padding-block-start: var(--space-4);
	}

	.project-card:last-child {
		border-block-end: none;
		padding-block-end: 0;
	}

	.project-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.project-title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--c-text);
		line-height: 1.4;
		letter-spacing: -0.01em;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15em 0;
		font-size: var(--text-meta);
		color: var(--c-text-muted);
	}

	.project-period {
		font-weight: 500;
		color: var(--c-text-sub);
	}

	.project-meta-sep {
		margin-inline: 0.5em;
		color: var(--c-line-strong);
	}

	.project-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.1em 0;
		font-size: var(--text-meta);
		color: var(--c-text-sub);
		line-height: 1.6;
	}

	.project-tag-sep {
		margin-inline: 0.4em;
		color: var(--c-text-muted);
		user-select: none;
	}

	.project-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		white-space: nowrap;
	}

	.skill-icon {
		flex-shrink: 0;
		width: 0.95em;
		height: 0.95em;
		color: var(--c-text-muted);
	}

	.project-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.project-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.project-block-label {
		margin: 0;
		font-size: var(--text-meta);
		font-weight: 700;
		color: var(--c-text);
	}

	.project-block-text {
		margin: 0;
		font-size: var(--text-body);
		line-height: 1.8;
		color: var(--c-text-sub);
		max-width: min(var(--measure-body), 100%);
	}

	@media print {
		.section {
			gap: var(--space-3);
		}

		.section-heading {
			padding-block-end: var(--space-1);
			border-color: var(--c-print-text);
			break-after: avoid;
		}

		.project-card {
			padding: var(--space-3) 0;
			gap: var(--space-2);
			border-color: var(--c-print-line);
			break-inside: auto;
			break-before: auto;
		}

		.project-header {
			gap: var(--space-1);
			break-inside: avoid;
			break-after: avoid;
		}

		.project-body {
			gap: var(--space-2);
		}

		.project-block-label {
			break-after: avoid;
		}

		.project-block-text {
			line-height: 1.55;
			max-width: none;
			orphans: 3;
			widows: 3;
		}
	}
</style>
