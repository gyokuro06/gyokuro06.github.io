---
import { projects } from '../data/works';
import { getIcon } from '../lib/icons';
---

<section class="section" aria-labelledby="projects-heading">
	<div class="section-heading">
		<span class="section-num" aria-hidden="true">02</span>
		<h2 id="projects-heading" class="section-title">参画プロジェクト</h2>
	</div>
	<div class="project-list">
		{projects.map((project) => (
			<article class="project-card" aria-label={project.title}>
				<header class="project-header">
					<h3 class="project-title">{project.title}</h3>
					<dl class="project-meta">
						<div class="project-meta-row">
							<dt class="project-meta-key">period</dt>
							<dd class="project-meta-val project-period">{project.period}</dd>
						</div>
						<div class="project-meta-row">
							<dt class="project-meta-key">team</dt>
							<dd class="project-meta-val">{project.teamSize}</dd>
						</div>
						<div class="project-meta-row">
							<dt class="project-meta-key">role</dt>
							<dd class="project-meta-val">{project.role}</dd>
						</div>
					</dl>
					<ul class="project-tags">
						{project.techStack.map((tech) => {
							const icon = getIcon(tech);
							return (
								<li class="project-tag">
									{icon && (
										<svg
											class="skill-icon"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path d={icon.path} fill="currentColor" />
										</svg>
									)}
									{tech}
								</li>
							);
						})}
					</ul>
				</header>
				<div class="project-body">
					<div class="project-block">
						<h3 class="project-block-label">概要</h3>
						<p class="project-block-text">{project.summary}</p>
					</div>
					<div class="project-block">
						<h3 class="project-block-label">課題と解決</h3>
						<p class="project-block-text">{project.challenge}</p>
					</div>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--c-line);
	}

	.section-num {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--c-text-muted);
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
	}

	.section-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-xl);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--c-text);
	}

	.project-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.project-card {
		background: var(--c-surface);
		border: 1px solid var(--c-line);
		border-radius: var(--radius-md);
		padding: var(--space-4) var(--space-4);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.project-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.project-title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--c-text);
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.project-meta {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, max-content));
		column-gap: var(--space-5);
		row-gap: var(--space-1);
		font-size: var(--text-xs);
	}

	.project-meta-row {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: baseline;
		gap: 0.45em;
		min-width: 0;
	}

	.project-meta-key {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.92em;
		font-weight: 500;
		color: var(--c-text-muted);
		letter-spacing: 0.02em;
		text-transform: lowercase;
	}

	.project-meta-val {
		margin: 0;
		color: var(--c-text-sub);
		font-weight: 500;
		min-width: 0;
	}

	.project-period {
		font-variant-numeric: tabular-nums;
		color: var(--c-text);
		font-weight: 700;
	}

	.project-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3em;
	}

	.project-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		padding: 0.15em 0.4em;
		border: 1px solid var(--c-chip-border);
		border-radius: var(--radius-sm);
		background: var(--c-chip-bg);
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--c-chip-text);
		line-height: 1.4;
	}

	.skill-icon {
		flex-shrink: 0;
		width: 0.95em;
		height: 0.95em;
		color: var(--c-text-muted);
	}

	.project-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-block-start: var(--space-1);
		border-block-start: 1px solid var(--c-line);
	}

	.project-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.project-block-label {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--c-text-muted);
	}

	.project-block-text {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.7;
		color: var(--c-text);
		max-width: min(var(--measure-body), 100%);
	}

	@media (max-width: 36rem) {
		.project-meta {
			grid-template-columns: 1fr;
		}
	}

	@media print {
		.section {
			gap: var(--space-2);
		}

		.section-heading {
			padding-block-end: var(--space-1);
			gap: var(--space-2);
			border-color: var(--c-print-line);
			break-after: avoid;
		}

		.section-num {
			color: var(--c-print-muted);
		}

		.project-list {
			gap: var(--space-2);
		}

		.project-card {
			padding: var(--space-2) var(--space-3);
			gap: var(--space-2);
			background: var(--c-print-bg);
			border-color: var(--c-print-tag-border);
			break-inside: auto;
			break-before: auto;
		}

		.project-header {
			gap: var(--space-1);
			break-inside: avoid;
			break-after: avoid;
		}

		.project-meta-key {
			color: var(--c-print-muted);
		}

		.project-meta-val {
			color: var(--c-print-text);
		}

		.project-tags {
			gap: 0.15em;
		}

		.project-tag {
			padding: 0.08em 0.3em;
			background: var(--c-print-tag-bg);
			border-color: var(--c-print-tag-border);
			color: var(--c-print-tag-text);
		}

		.skill-icon {
			color: var(--c-print-muted);
		}

		.project-body {
			gap: var(--space-2);
			border-color: var(--c-print-line);
		}

		.project-block-label {
			color: var(--c-print-muted);
			break-after: avoid;
		}

		.project-block-text {
			line-height: 1.5;
			max-width: none;
			orphans: 3;
			widows: 3;
		}
	}
</style>
