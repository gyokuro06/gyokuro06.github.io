---
import { companies, projects } from '../data/works';
import { companyNameById } from '../lib/timeline';
import { getIcon, isLightBrand } from '../lib/icons';
---

<section class="section" aria-labelledby="projects-heading">
	<div class="section-heading">
		<h2 id="projects-heading" class="section-title">参画プロジェクト</h2>
	</div>
	<div class="project-list">
		{projects.map((project) => (
			<article class="project-entry" aria-label={project.title}>
				<header class="project-header">
					<p class="project-company">{companyNameById(companies, project.companyId)}</p>
					<h3 class="project-title">{project.title}</h3>
					<div class="project-meta">
						<span class="project-period">{project.period}</span>
						<span class="project-meta-item">チーム {project.teamSize}</span>
						<span class="project-meta-item">{project.role}</span>
					</div>
					<ul class="project-tags" role="list" aria-label={`${project.title}の技術スタック`}>
						{project.techStack.map((tech) => {
							const icon = getIcon(tech);
							const lightBrand = icon ? isLightBrand(icon.hex) : false;
							return (
								<li
									class="project-tag"
									style={icon ? `--brand: #${icon.hex}` : undefined}
									data-has-icon={icon ? '' : undefined}
									data-brand-light={lightBrand ? '' : undefined}
									title={tech}
									aria-label={tech}
								>
									{icon?.path && (
										<svg
											class="skill-icon"
											viewBox="0 0 24 24"
											aria-hidden="true"
											focusable="false"
										>
											<path d={icon.path} fill="currentColor" />
										</svg>
									)}
									<span aria-hidden="true">{tech}</span>
								</li>
							);
						})}
					</ul>
				</header>
				<div class="project-body">
					<div class="project-block">
						<p class="project-block-label">概要</p>
						<p class="project-block-text">{project.summary}</p>
					</div>
					<div class="project-block">
						<p class="project-block-label">課題と解決</p>
						<p class="project-block-text">{project.challenge}</p>
					</div>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.section-heading {
		padding-block-end: 0;
	}

	.section-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-xl);
		font-weight: 700;
		letter-spacing: 0;
		color: var(--c-text);
	}

	/*
	 * 近接のメリハリ（線なし）:
	 * 案件のあいだ >> ヘッダと本文 > 概要と課題 > ラベルと本文
	 */
	.project-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-16);
	}

	.project-entry {
		padding-block: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.project-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.project-company {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.4;
		color: var(--c-text-muted);
	}

	.project-title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--c-text);
		line-height: 1.4;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35em 1em;
		font-size: var(--text-sm);
		color: var(--c-text-sub);
	}

	.project-period {
		font-weight: 700;
		color: var(--c-text);
	}

	.project-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3em 0.45em;
	}

	.project-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		padding: 0.2em 0.5em;
		border: none;
		border-radius: var(--radius-sm);
		background: var(--c-accent-soft);
		font-size: var(--text-xs);
		font-weight: 400;
		color: var(--c-text);
		line-height: 1.5;
	}

	.project-tag[data-has-icon] {
		background: color-mix(in srgb, var(--brand) 22%, var(--c-mix-paper));
		color: color-mix(in srgb, var(--brand) 78%, #000000);
	}

	.project-tag[data-has-icon][data-brand-light] {
		background: color-mix(in srgb, var(--brand) 12%, var(--c-mix-paper));
		color: var(--c-text);
	}

	.project-tag[data-has-icon][data-brand-light] .skill-icon {
		color: color-mix(in srgb, var(--brand) 65%, var(--c-mix-ink));
	}

	.skill-icon {
		flex-shrink: 0;
		width: 1em;
		height: 1em;
		color: var(--brand, currentColor);
	}

	.project-tag:not([data-has-icon]) .skill-icon {
		opacity: 0.7;
	}

	.project-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.project-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	/* スキルカテゴリと同系: 控えめラベル（本文とコントラスト） */
	.project-block-label {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.5;
		color: var(--c-text-muted);
	}

	.project-block-text {
		margin: 0;
		font-size: var(--text-md);
		line-height: 1.85;
		color: var(--c-text);
		max-width: min(var(--measure-body), 100%);
	}

	@media print {
		.section {
			gap: var(--space-3);
		}

		.section-heading {
			padding-block-end: 0;
			break-after: avoid;
		}

		.project-list {
			gap: var(--space-8);
		}

		.project-entry {
			gap: var(--space-2);
			break-inside: auto;
			break-before: auto;
		}

		.project-header {
			gap: var(--space-1);
			break-inside: avoid;
			break-after: avoid;
		}

		.project-company {
			color: var(--c-print-muted);
		}

		.project-meta {
			color: var(--c-print-muted);
		}

		.project-period {
			color: var(--c-print-text);
		}

		.project-tags {
			gap: 0.2em;
		}

		.project-tag,
		.project-tag[data-has-icon] {
			padding: 0.1em 0.4em;
			background: var(--c-print-tag-bg);
			color: var(--c-print-tag-text);
		}

		.skill-icon {
			color: currentColor;
		}

		.project-body {
			gap: var(--space-2);
		}

		.project-block {
			gap: 0.15rem;
		}

		.project-block-label {
			color: var(--c-print-muted);
			break-after: avoid;
		}

		.project-block-text {
			line-height: 1.55;
			max-width: none;
			orphans: 3;
			widows: 3;
		}
	}
</style>
