---
import { profile } from '../data/works';
---

<header class="intro">
	<div class="intro-inner">
		<div class="intro-body">
			<p class="intro-role" aria-label="肩書き">{profile.title}</p>
			<h1 class="intro-name" contenteditable="true" spellcheck="false">{profile.name}</h1>
			<div class="intro-lead">
				{profile.lead.map((line) => (
					<p>
						{line.split('|').flatMap((phrase, i) =>
							i === 0 ? [phrase] : [<wbr />, phrase],
						)}
					</p>
				))}
			</div>
		</div>
		<div class="intro-action no-print">
			<button class="pdf-btn" onclick="window.print()">PDF 出力</button>
		</div>
	</div>
</header>

<style>
	.intro {
		background: var(--c-bg);
	}

	.intro-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: clamp(var(--space-5), 3vw, var(--space-8));
		width: var(--page-width);
		margin-inline: auto;
		padding-block: clamp(var(--space-8), 4vw, var(--space-12)) clamp(var(--space-7), 3vw, var(--space-10));
	}

	.intro-body {
		flex: 1 1 16rem;
		min-width: 0;
	}

	.intro-role {
		margin: 0 0 var(--space-2);
		font-size: var(--text-sm);
		font-weight: 400;
		letter-spacing: 0;
		color: var(--c-text-muted);
	}

	.intro-name {
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--c-text);
		padding-inline: var(--space-1);
		margin-inline: calc(var(--space-1) * -1);
		cursor: text;
		outline: none;
	}

	.intro-name:not(:focus):hover {
		background: color-mix(in srgb, var(--c-accent) 4%, transparent);
	}

	.intro-name:focus {
		background: color-mix(in srgb, var(--c-accent) 3%, transparent);
		box-shadow: 0 1px 0 0 var(--c-accent);
	}

	/* contenteditable を空にすると <br> だけ残ることがある */
	.intro-name:empty:not(:focus),
	.intro-name:has(> br:only-child):not(:focus) {
		margin: 0;
		padding: 0;
		font-size: 0;
		line-height: 0;
		overflow: hidden;
	}


	.intro-lead {
		max-width: var(--measure-lead);
		color: var(--c-text-sub);
		font-size: var(--text-md);
		line-height: 1.9;
		word-break: keep-all;
		overflow-wrap: anywhere;
		line-break: strict;
		text-wrap: pretty;
	}

	.intro-lead p {
		margin: 0;
	}

	.intro-action {
		flex: 0 0 auto;
		padding-top: var(--space-1);
	}

	.pdf-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.45em 0.95em;
		border: 1px solid var(--c-accent);
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--c-accent);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 700;
		cursor: pointer;
		transition: background 0.12s, color 0.12s;
		white-space: nowrap;
	}

	.pdf-btn:hover {
		background: var(--c-accent);
		color: var(--c-on-accent);
	}

	@media print {
		.intro {
			background: var(--c-print-bg);
			break-inside: avoid;
			break-after: avoid;
		}

		.intro-inner {
			width: 100%;
			padding-block: var(--space-3) var(--space-2);
			gap: var(--space-3);
		}

		.intro-role {
			margin-bottom: var(--space-1);
			color: var(--c-print-muted);
		}

		.intro-name {
			margin-bottom: var(--space-2);
			font-size: var(--text-2xl);
			padding-inline: 0;
			margin-inline: 0;
			background: transparent;
			box-shadow: none;
			cursor: default;
		}


		.intro-lead {
			line-height: 1.55;
			max-width: none;
			color: var(--c-print-text);
		}
	}
</style>
