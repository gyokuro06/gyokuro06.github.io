---
import { skillCategories } from '../data/works';
import { getIcon, isLightBrand } from '../lib/icons';
---

<section class="section" aria-labelledby="skills-heading">
	<div class="section-heading">
		<h2 id="skills-heading" class="section-title">スキル</h2>
	</div>
	<div class="skill-table">
		{skillCategories.map((cat, catIndex) => {
			const labelId = `skill-cat-${catIndex}`;
			return (
				<div class="skill-row">
					<span class="skill-cat-label" id={labelId}>{cat.label}</span>
					<ul class="skill-tags" role="list" aria-labelledby={labelId}>
						{cat.items.toSorted((a, b) => b.years - a.years).map((item) => {
							const icon = getIcon(item.name);
							const accessibleName = `${item.name}、経験${item.years}年`;
							const lightBrand = icon ? isLightBrand(icon.hex) : false;
							return (
								<li
									class="skill-tag"
									style={icon ? `--brand: #${icon.hex}` : undefined}
									data-has-icon={icon ? '' : undefined}
									data-brand-light={lightBrand ? '' : undefined}
									title={accessibleName}
									aria-label={accessibleName}
								>
									{icon?.path && (
										<svg
											class="skill-icon"
											viewBox="0 0 24 24"
											aria-hidden="true"
											focusable="false"
										>
											<path d={icon.path} fill="currentColor" />
										</svg>
									)}
									<span aria-hidden="true">{item.name}</span>
									<span class="skill-tag-years" aria-hidden="true">{item.years}年</span>
								</li>
							);
						})}
					</ul>
				</div>
			);
		})}
	</div>
</section>

<style>
	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.section-heading {
		padding-block-end: 0;
	}

	.section-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-xl);
		font-weight: 700;
		letter-spacing: 0;
		color: var(--c-text);
	}

	/* 4原則: 近接(カテゴリ間余白) / 整列(左レール固定) / 反復(同じ型) / コントラスト(ラベル控えめ・バッジが主役) — 行間の罫線は使わない */
	.skill-table {
		container-type: inline-size;
		container-name: skills;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.skill-row {
		display: grid;
		grid-template-columns: var(--skill-label-col) 1fr;
		gap: var(--space-2) var(--space-5);
		align-items: start;
		padding-block: 0;
	}

	.skill-cat-label {
		margin: 0;
		padding-top: 0.35em; /* バッジ1行目のキャップに近づける */
		font-size: var(--text-sm);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.5;
		color: var(--c-text-muted);
		white-space: nowrap;
	}

	.skill-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3em 0.45em;
	}

	.skill-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		padding: 0.2em 0.55em;
		border: none;
		border-radius: var(--radius-sm);
		background: var(--c-accent-soft);
		font-size: var(--text-xs);
		font-weight: 400;
		color: var(--c-text);
		line-height: 1.5;
		white-space: nowrap;
	}

	.skill-tag[data-has-icon] {
		background: color-mix(in srgb, var(--brand) 22%, var(--c-mix-paper));
		color: color-mix(in srgb, var(--brand) 78%, #000000);
	}

	.skill-tag[data-has-icon][data-brand-light] {
		background: color-mix(in srgb, var(--brand) 12%, var(--c-mix-paper));
		color: var(--c-text);
	}

	.skill-tag[data-has-icon][data-brand-light] .skill-icon {
		color: color-mix(in srgb, var(--brand) 65%, var(--c-mix-ink));
	}

	.skill-tag[data-has-icon][data-brand-light] .skill-tag-years {
		color: var(--c-text-muted);
	}

	.skill-tag-years {
		font-size: 0.85em;
		color: color-mix(in srgb, currentColor 60%, transparent);
	}

	.skill-icon {
		flex-shrink: 0;
		width: 1em;
		height: 1em;
		color: var(--brand, currentColor);
	}

	.skill-tag:not([data-has-icon]) .skill-icon {
		opacity: 0.7;
	}

	@container skills (max-width: 40rem) {
		.skill-row {
			grid-template-columns: 1fr;
		}
	}

	@media print {
		.section {
			gap: var(--space-3);
			break-inside: avoid;
		}

		.section-heading {
			padding-block-end: 0;
		}

		.skill-table {
			gap: var(--space-3);
		}

		.skill-row {
			gap: var(--space-1) var(--space-3);
			break-inside: avoid;
		}

		.skill-cat-label {
			color: var(--c-print-muted);
		}

		.skill-tags {
			gap: 0.2em;
		}

		.skill-tag,
		.skill-tag[data-has-icon] {
			padding: 0.12em 0.45em;
			background: var(--c-print-tag-bg);
			color: var(--c-print-tag-text);
		}

		.skill-tag-years {
			color: var(--c-print-muted);
		}

		.skill-icon {
			color: currentColor;
		}
	}
</style>
