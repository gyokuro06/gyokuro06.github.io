---
import { skillCategories } from '../data/works';
import { getIcon } from '../lib/icons';
---

<section class="section" aria-labelledby="skills-heading">
	<div class="section-heading">
		<span class="section-num" aria-hidden="true">01</span>
		<h2 id="skills-heading" class="section-title">スキル</h2>
	</div>
	<div class="skill-table">
		{skillCategories.map((cat) => (
			<div class="skill-row">
				<span class="skill-cat-label">{cat.label}</span>
				<ul class="skill-tags">
					{cat.items.toSorted((a, b) => b.years - a.years).map((item) => {
						const icon = getIcon(item.name);
						return (
							<li class="skill-tag">
								{icon && (
									<svg
										class="skill-icon"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<path d={icon.path} fill="currentColor" />
									</svg>
								)}
								{item.name}
								<span class="skill-tag-years">{item.years}年</span>
							</li>
						);
					})}
				</ul>
			</div>
		))}
	</div>
</section>

<style>
	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--c-line);
	}

	.section-num {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--c-text-muted);
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
	}

	.section-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-xl);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--c-text);
	}

	.skill-table {
		container-type: inline-size;
		container-name: skills;
		display: flex;
		flex-direction: column;
		gap: 0;
		border: 1px solid var(--c-line);
		border-radius: var(--radius-md);
		background: var(--c-surface);
		overflow: hidden;
	}

	.skill-row {
		display: grid;
		grid-template-columns: minmax(min-content, var(--skill-label-col)) 1fr;
		gap: var(--space-2) var(--space-4);
		align-items: start;
		padding: var(--space-2) var(--space-3);
		border-block-end: 1px solid var(--c-line);
	}

	.skill-row:last-child {
		border-block-end: none;
	}

	.skill-cat-label {
		padding-top: 0.2em;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--c-text-muted);
		white-space: nowrap;
	}

	.skill-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3em;
	}

	.skill-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		padding: 0.2em 0.45em;
		border: 1px solid var(--c-chip-border);
		border-radius: var(--radius-sm);
		background: var(--c-chip-bg);
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--c-chip-text);
		line-height: 1.4;
		white-space: nowrap;
	}

	.skill-tag-years {
		font-size: 0.85em;
		font-variant-numeric: tabular-nums;
		color: var(--c-text-muted);
	}

	.skill-icon {
		flex-shrink: 0;
		width: 0.95em;
		height: 0.95em;
		color: var(--c-text-muted);
	}

	@container skills (max-width: 40rem) {
		.skill-row {
			grid-template-columns: 1fr;
		}
	}

	@media print {
		.section {
			gap: var(--space-2);
			break-inside: avoid;
		}

		.section-heading {
			padding-block-end: var(--space-1);
			gap: var(--space-2);
			border-color: var(--c-print-line);
		}

		.section-num {
			color: var(--c-print-muted);
		}

		.skill-table {
			border-color: var(--c-print-line);
			background: var(--c-print-bg);
		}

		.skill-row {
			padding: 0.2rem 0.4rem;
			gap: var(--space-1) var(--space-3);
			border-color: var(--c-print-line);
			break-inside: avoid;
		}

		.skill-tags {
			gap: 0.2em;
		}

		.skill-tag {
			padding: 0.1em 0.35em;
			background: var(--c-print-tag-bg);
			border-color: var(--c-print-tag-border);
			color: var(--c-print-tag-text);
		}

		.skill-tag-years {
			color: var(--c-print-muted);
		}

		.skill-icon {
			color: var(--c-print-muted);
		}
	}
</style>
