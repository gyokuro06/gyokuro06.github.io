---
import { skillCategories } from '../data/works';
import { getIcon } from '../lib/icons';
---

<section class="section" aria-labelledby="skills-heading">
	<div class="section-heading">
		<h2 id="skills-heading" class="section-title">スキル</h2>
	</div>
	<div class="skill-table">
		{skillCategories.map((cat) => (
			<div class="skill-row">
				<span class="skill-cat-label">{cat.label}</span>
				<ul class="skill-list">
					{cat.items.toSorted((a, b) => b.years - a.years).map((item, i) => {
						const icon = getIcon(item.name);
						return (
							<>
								{i > 0 && (
									<li class="skill-sep" aria-hidden="true">·</li>
								)}
								<li class="skill-item">
									{icon && (
										<svg
											class="skill-icon"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path d={icon.path} fill="currentColor" />
										</svg>
									)}
									<span class="skill-name">{item.name}</span>
									<span class="skill-years">{item.years}年</span>
								</li>
							</>
						);
					})}
				</ul>
			</div>
		))}
	</div>
</section>

<style>
	.section {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.section-heading {
		padding-block-end: var(--space-2);
		border-block-end: 1px solid var(--c-text);
	}

	.section-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-h2);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--c-text);
		line-height: 1.3;
	}

	.skill-table {
		container-type: inline-size;
		container-name: skills;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.skill-row {
		display: grid;
		grid-template-columns: minmax(min-content, var(--skill-label-col)) 1fr;
		gap: var(--space-2) var(--space-5);
		align-items: baseline;
		padding-block: var(--space-3);
		border-block-end: 1px solid var(--c-line);
	}

	.skill-row:last-child {
		border-block-end: none;
	}

	.skill-cat-label {
		font-size: var(--text-meta);
		font-weight: 700;
		color: var(--c-text);
		white-space: nowrap;
	}

	.skill-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15em 0;
		font-size: var(--text-sm);
		line-height: 1.7;
		color: var(--c-text-sub);
	}

	.skill-sep {
		margin-inline: 0.45em;
		color: var(--c-text-muted);
		user-select: none;
	}

	.skill-item {
		display: inline-flex;
		align-items: baseline;
		gap: 0.3em;
		white-space: nowrap;
	}

	.skill-name {
		font-weight: 500;
		color: var(--c-text);
	}

	.skill-years {
		font-size: 0.9em;
		color: var(--c-text-muted);
	}

	.skill-icon {
		flex-shrink: 0;
		width: 0.95em;
		height: 0.95em;
		align-self: center;
		color: var(--c-text-muted);
	}

	@container skills (max-width: 40rem) {
		.skill-row {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}

	@media print {
		.section {
			gap: var(--space-3);
			break-inside: avoid;
		}

		.section-heading {
			padding-block-end: var(--space-1);
			border-color: var(--c-print-text);
		}

		.skill-row {
			padding-block: 0.2rem;
			gap: var(--space-1) var(--space-3);
			break-inside: avoid;
			border-color: var(--c-print-line);
		}

		.skill-list {
			line-height: 1.55;
		}
	}
</style>
